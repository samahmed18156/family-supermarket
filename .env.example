# Family Supermarket - FREE Config
# Copy this to .env and change values

# Admin key for /admin?key=YOUR_KEY
ADMIN_KEY=changeme

# Business WhatsApp - NEW NUMBER 063 837 8201
# Format: Country code + number without leading 0
# South Africa 063 837 8201 -> 27638378201
BUSINESS_WHATSAPP=27638378201

# Display version (with spaces, for humans)
BUSINESS_PHONE_DISPLAY=063 837 8201

# Google Search Console Verification (FREE SEO)
# Get from https://search.google.com/search-console
# Paste the content value only
GOOGLE_VERIFICATION=

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-in-production
